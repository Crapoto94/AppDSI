server {
    listen 5174;
    server_name localhost;
    client_max_body_size 30M;

    root /usr/share/nginx/html;
    index index.html;

    # Compression : sans elle, les 70 Mo de l'éditeur PDF (PdfCraft, WebAssembly) circulaient en clair (~30 s à l'ouverture)
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/wasm application/javascript text/javascript text/css application/json image/svg+xml text/plain application/xml;

    # PdfCraft : fichiers à nom unique (hash) → mis en cache 30 jours par le navigateur, même après un redéploiement
    # (sinon l'ETag change à chaque déploiement et tout est retéléchargé). Seule la page d'entrée est revalidée souvent.
    location /pdfcraft/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        etag off;
    }
    location = /pdfcraft/index.html {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    # Pages publiques du DSI Hub servies sous le domaine MagApp : liens de validation du service fait envoyés par mail
    # (workflows lancés depuis « Mes factures »). La page est celle du Hub (proxy vers son conteneur) ; ses scripts
    # /assets/* absents de MagApp sont aussi relayés. Variable + resolver : MagApp démarre même si le Hub est arrêté.
    location ~ ^/(service-fait-verifier|service-fait-visa)/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $hub_front ${HUB_FRONTEND_URL};
        proxy_pass $hub_front;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri @hub_assets;
    }

    location @hub_assets {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $hub_front ${HUB_FRONTEND_URL};
        proxy_pass $hub_front;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # Sans URI dans proxy_pass : le chemin demandé est transmis tel quel (un « %2F » n'est plus décodé en « / » — cassait /api/page-help/%2Fmagapp)
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass ${BACKEND_URL}/uploads/;
    }

    location /img/ {
        proxy_pass ${BACKEND_URL}/img/;
    }

    location /magapp_img/ {
        proxy_pass ${BACKEND_URL}/magapp_img/;
    }

    location /storage/ {
        proxy_pass ${BACKEND_URL}/storage/;
    }
}
