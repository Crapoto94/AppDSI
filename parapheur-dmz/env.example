# Copier ce fichier en ".env" dans ce même dossier, puis renseigner les valeurs réelles.
# (Ne pas committer le ".env".)

# Adresse LAN du backend AppDSI, joignable DEPUIS l'hôte Docker de la DMZ
# (firewall : DMZ -> LAN, TCP 3001 uniquement). C'est l'IP/hostname de l'hôte
# qui publie le port 3001 (docker-compose.yml racine, service "backend").
BACKEND_URL=http://<ip-lan-du-serveur-appdsi>:3001

# Nom de domaine public utilisé pour le lien de vérification (QR des PDF signés).
# Ex. chat.ivry94.fr (déjà réservé) ou un sous-domaine dédié parapheur.ivry94.fr.
# Cette valeur DOIT correspondre à "URL publique" définie dans
# /admin/parapheur-certificats (réglage parapheur.public_base_url).
VERIFY_DOMAIN=chat.ivry94.fr
