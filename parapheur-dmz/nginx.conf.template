server {
    listen 5176;
    server_name ${VERIFY_DOMAIN};
    client_max_body_size 10M;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de base pour un service exposé en DMZ. (TLS/HSTS terminés par le
    # reverse proxy DMZ en amont.)
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # SPA du Hub : seule la route /parapheur/verification/:token est réellement
    # fonctionnelle (les autres routes s'affichent mais leurs appels /api/* ne
    # sont pas proxifiés et échouent).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SEUL point d'entrée backend exposé : l'API PUBLIQUE de vérification du
    # parapheur (jeton aléatoire non devinable, lecture seule). On ne proxy
    # JAMAIS /api/ dans son ensemble : le backend est un monolithe qui sert
    # aussi les tickets, la finance, la RH et l'admin.
    location /api/parapheur/verify/ {
        proxy_pass ${BACKEND_URL}/api/parapheur/verify/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
