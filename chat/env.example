# Copier ce fichier en ".env" dans ce même dossier, puis renseigner les valeurs réelles.
# (Ce fichier "env.example" est suivi par git ; le futur ".env" avec vos vraies valeurs
# ne doit PAS être commité.)

# Adresse LAN du backend AppDSI, joignable DEPUIS l'hôte Docker de la DMZ
# (le firewall doit autoriser ce flux précis : DMZ -> LAN, TCP 3001 uniquement).
# C'est l'IP/hostname de l'hôte Proxmox qui publie le port 3001 (cf. docker-compose.yml
# à la racine du projet, service "backend").
BACKEND_URL=http://<ip-lan-du-serveur-appdsi>:3001

# Nom de domaine public du chat (déjà réservé : chat.ivry94.fr)
CHAT_DOMAIN=chat.ivry94.fr
