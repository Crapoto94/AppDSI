<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Création d'une boîte mail partagée" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Processus de demande, d'arbitrage et de création d'une boîte mail partagée, liste de diffusion ou liste de sécurité : formulaire « Demande de boite mail partagée » (MagApp), ticket et fiche d'inventaire, arbitrage DSI, création Exchange/O365, délégation des droits, vérification AD puis O365, gestion des boîtes provisoires. Reconstitué à partir du code d'AppDSI (request-forms, mailboxes, tâches d'arbitrage).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
        <bpmn:lane id="Lane_0" name="Demandeur">
          <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Form</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_1" name="AppDSI (Tickets, Tâches, Boîtes partagées)">
          <bpmn:flowNodeRef>T_Ticket</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Fiche</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Arb</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_ArbTask</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Pos</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_FormTasks</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Verify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Verif</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Watch</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Timer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Del</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Arch</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_DSIHub</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_2" name="Arbitres DSI">
          <bpmn:flowNodeRef>T_Decide</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_3" name="Administrateurs messagerie">
          <bpmn:flowNodeRef>T_Create</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Rights</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Members</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Complete</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Perm</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Archive</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_Outlook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_AD</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_4" name="Hot-line DSI">
          <bpmn:flowNodeRef>T_Refus</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Refus</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Resolve</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Prov</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Ok</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="S" name="Besoin d'une adresse collective">
        <bpmn:documentation>Un service a besoin d'une adresse partagée : boîte partagée (Shared Mailbox), liste de diffusion ou liste de sécurité.</bpmn:documentation>
        <bpmn:outgoing>F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_Form" name="Remplir la demande « Demande de boite mail partagée »">
        <bpmn:documentation>Formulaire de demande paramétrable (portail MagApp). Clés de champ fixes attendues : nom (nom ou adresse), type (boîte partagée / liste de diffusion / liste de sécurité), usage (interne / externe), admi (agent responsable, recherche AD avec badge de présence RH), provisoire (case) + datefin, membres (plusieurs agents) et justification.</bpmn:documentation>
        <bpmn:incoming>F01</bpmn:incoming>
        <bpmn:outgoing>F02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Ticket" name="Créer le ticket de demande">
        <bpmn:documentation>AppDSI crée le ticket (type Demande, catégorie/sous-catégorie du formulaire, source magapp) et journalise la soumission (hub.request_form_submissions). Le SLA est appliqué, la confirmation est envoyée au demandeur.</bpmn:documentation>
        <bpmn:incoming>F02</bpmn:incoming>
        <bpmn:outgoing>F03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Fiche" name="Créer la fiche d'inventaire (arbitrage en attente)">
        <bpmn:documentation>special_action = boite_partagee : mailboxesService.createRecord alimente hub.shared_mailboxes (nom, type, usage, responsable, provisoire, date de fin, membres, justification, ticket_id, form_id, demandeur). arbitrage_decision reste NULL tant qu'aucune décision n'est rendue. Un échec est journalisé sans annuler le ticket.</bpmn:documentation>
        <bpmn:incoming>F03</bpmn:incoming>
        <bpmn:outgoing>F04</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_DSIHub"><bpmn:targetRef>App_DSIHub</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Arb" name="Arbitrage activé ?">
        <bpmn:documentation>Paramètre du formulaire (arbitrage_enabled) : vers une personne (arbitrage_type = user) ou un groupe (arbitrage_type = group).</bpmn:documentation>
        <bpmn:incoming>F04</bpmn:incoming>
        <bpmn:outgoing>F05</bpmn:outgoing>
        <bpmn:outgoing>F06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_ArbTask" name="Créer la tâche d'arbitrage + notification">
        <bpmn:documentation>Une tâche « Arbitrage : &lt;formulaire&gt; » (hub.user_tasks, is_arbitrage) liée au ticket est créée pour la personne ou pour chaque membre du groupe (tâche d'équipe), puis notifiée par mail. Cas d'échec (groupe vide, aucune cible configurée) : action arbitrage_task_failed dans l'historique du ticket.</bpmn:documentation>
        <bpmn:incoming>F05</bpmn:incoming>
        <bpmn:outgoing>F07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_Decide" name="Instruire la demande et rendre la décision">
        <bpmn:documentation>L'arbitre contrôle : doublon avec une liste existante, responsable désigné (obligatoire), justification, usage externe ou interne. Décision « positif » ou « négatif ». Une justification est OBLIGATOIRE pour un arbitrage négatif. Un arbitrage ne peut être rendu qu'une fois.</bpmn:documentation>
        <bpmn:incoming>F07</bpmn:incoming>
        <bpmn:outgoing>F08</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Record" name="Enregistrer la décision (fiche synchronisée)">
        <bpmn:documentation>submitArbitrageDecision : tâche passée à « terminé » (pour tout le groupe si tâche d'équipe), événement arbitrage_decision écrit dans l'historique du ticket, puis mailboxesService.syncArbitrageDecision recopie décision et commentaire sur la fiche d'inventaire.</bpmn:documentation>
        <bpmn:incoming>F08</bpmn:incoming>
        <bpmn:outgoing>F09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Pos" name="Décision positive ?">
        <bpmn:incoming>F09</bpmn:incoming>
        <bpmn:outgoing>F10</bpmn:outgoing>
        <bpmn:outgoing>F11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Refus" name="Informer le demandeur du refus motivé et clore le ticket">
        <bpmn:documentation>Refus motivé (ex. redondance avec une liste existante). La fiche reste dans l'inventaire avec l'arbitrage « négatif ».</bpmn:documentation>
        <bpmn:incoming>F11</bpmn:incoming>
        <bpmn:outgoing>F12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_Refus" name="Demande refusée">
        <bpmn:incoming>F12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G_Merge">
        <bpmn:documentation>Convergence : décision positive ou formulaire sans arbitrage.</bpmn:documentation>
        <bpmn:incoming>F06</bpmn:incoming>
        <bpmn:incoming>F10</bpmn:incoming>
        <bpmn:outgoing>F13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_FormTasks" name="Créer les tâches à réaliser du formulaire">
        <bpmn:documentation>createFormTasks : liste libre de tâches définies dans le form-builder, TOUJOURS affectées à un groupe. Une tâche conditionnée (conditional_on) à une réponse non satisfaite n'est pas créée.</bpmn:documentation>
        <bpmn:incoming>F13</bpmn:incoming>
        <bpmn:outgoing>F14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_Create" name="Créer la boîte ou la liste dans Exchange / O365">
        <bpmn:documentation>Création sur le tenant O365 / Exchange selon le type : boîte partagée (sans licence), liste de diffusion ou groupe de sécurité Active Directory. Adresse au format nom@ville.fr. Aucune création automatique côté AppDSI : c'est une action d'administrateur.</bpmn:documentation>
        <bpmn:incoming>F14</bpmn:incoming>
        <bpmn:incoming>F22</bpmn:incoming>
        <bpmn:outgoing>F15</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_Outlook"><bpmn:targetRef>App_Outlook</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="T_Rights" name="Désigner le responsable et déléguer les droits">
        <bpmn:documentation>Le responsable titulaire est obligatoire. Droits par délégation NOMINATIVE (FullAccess / SendAs) via l'Active Directory : jamais de mot de passe partagé.</bpmn:documentation>
        <bpmn:incoming>F15</bpmn:incoming>
        <bpmn:outgoing>F16</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_AD"><bpmn:targetRef>App_AD</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="T_Members" name="Ajouter les membres">
        <bpmn:documentation>Membres indiqués dans la demande : délégués de la boîte ou membres de la liste (groupe AD).</bpmn:documentation>
        <bpmn:incoming>F16</bpmn:incoming>
        <bpmn:outgoing>F17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Complete" name="Compléter la fiche (adresse, date de création, options)">
        <bpmn:documentation>Dans /boites-partagees : adresse mail complète, date de création, options « Boîte DSI » et « Boîte système / technique », membres (updateRecord).</bpmn:documentation>
        <bpmn:incoming>F17</bpmn:incoming>
        <bpmn:outgoing>F18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Verify" name="Vérifier l'existence et les membres (AD puis O365)">
        <bpmn:documentation>GET /api/mailboxes/ad-members?email=… : sonde d'abord l'annuaire AD (délégués Accès total, membres du groupe), puis repli Microsoft Graph (O365 / Entra ID). Le résultat est appliqué à la fiche depuis le bouton « Récupérer depuis l'AD/O365 ».</bpmn:documentation>
        <bpmn:incoming>F18</bpmn:incoming>
        <bpmn:incoming>F23</bpmn:incoming>
        <bpmn:outgoing>F19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Verif" name="Résultat de la vérification ?">
        <bpmn:documentation>Quatre résultats possibles : trouvée dans l'AD ; trouvée dans O365 uniquement (boîte cloud, membres inconnus car Graph ne les expose pas) ; permission Graph manquante ; introuvable (AD et O365).</bpmn:documentation>
        <bpmn:incoming>F19</bpmn:incoming>
        <bpmn:outgoing>F20</bpmn:outgoing>
        <bpmn:outgoing>F21</bpmn:outgoing>
        <bpmn:outgoing>F22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Perm" name="Accorder la permission Group.Read.All (Entra ID)">
        <bpmn:documentation>Cas « permission_denied » : la permission Microsoft Graph « Group.Read.All » manque sur l'application Azure ; à accorder par un administrateur Entra ID, puis relancer la vérification.</bpmn:documentation>
        <bpmn:incoming>F21</bpmn:incoming>
        <bpmn:outgoing>F23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Resolve" name="Résoudre le ticket et prévenir le demandeur et le responsable">
        <bpmn:documentation>Solution enregistrée (« Solutionner »), notification du demandeur avec lien de réponse et de réouverture. Le compteur de messages (total / non lus, Graph) peut ensuite être synchronisé depuis la fiche (POST /api/mailboxes/:id/sync-mail-counts).</bpmn:documentation>
        <bpmn:incoming>F20</bpmn:incoming>
        <bpmn:outgoing>F24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_Prov" name="Boîte provisoire ?">
        <bpmn:documentation>Case « Provisoire » du formulaire, avec une date de fin de validité (ex. élections, festival, commission d'enquête).</bpmn:documentation>
        <bpmn:incoming>F24</bpmn:incoming>
        <bpmn:outgoing>F25</bpmn:outgoing>
        <bpmn:outgoing>F26</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_Ok" name="Boîte partagée opérationnelle">
        <bpmn:incoming>F25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_Watch" name="Surveiller la date de fin (alerte d'échéance)">
        <bpmn:documentation>La fiche signale visuellement le dépassement de la date de fin pour inviter l'administrateur à archiver ou supprimer la boîte, après confirmation du responsable.</bpmn:documentation>
        <bpmn:incoming>F26</bpmn:incoming>
        <bpmn:outgoing>F27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="E_Timer" name="Date de fin atteinte">
        <bpmn:incoming>F27</bpmn:incoming>
        <bpmn:outgoing>F28</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_E_Timer" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="T_Archive" name="Sauvegarder (PST) puis supprimer la boîte">
        <bpmn:documentation>Sauvegarde PST ou archivage des courriels AVANT suppression définitive de l'adresse.</bpmn:documentation>
        <bpmn:incoming>F28</bpmn:incoming>
        <bpmn:outgoing>F29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Del" name="Supprimer la fiche de l'inventaire">
        <bpmn:documentation>mailboxes DELETE /api/mailboxes/:id.</bpmn:documentation>
        <bpmn:incoming>F29</bpmn:incoming>
        <bpmn:outgoing>F30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_Arch" name="Boîte archivée">
        <bpmn:incoming>F30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="T_Form" />
      <bpmn:sequenceFlow id="F02" sourceRef="T_Form" targetRef="T_Ticket" />
      <bpmn:sequenceFlow id="F03" sourceRef="T_Ticket" targetRef="T_Fiche" />
      <bpmn:sequenceFlow id="F04" sourceRef="T_Fiche" targetRef="G_Arb" />
      <bpmn:sequenceFlow id="F05" name="oui" sourceRef="G_Arb" targetRef="T_ArbTask" />
      <bpmn:sequenceFlow id="F06" name="non" sourceRef="G_Arb" targetRef="G_Merge" />
      <bpmn:sequenceFlow id="F07" sourceRef="T_ArbTask" targetRef="T_Decide" />
      <bpmn:sequenceFlow id="F08" sourceRef="T_Decide" targetRef="T_Record" />
      <bpmn:sequenceFlow id="F09" sourceRef="T_Record" targetRef="G_Pos" />
      <bpmn:sequenceFlow id="F10" name="oui" sourceRef="G_Pos" targetRef="G_Merge" />
      <bpmn:sequenceFlow id="F11" name="non" sourceRef="G_Pos" targetRef="T_Refus" />
      <bpmn:sequenceFlow id="F12" sourceRef="T_Refus" targetRef="E_Refus" />
      <bpmn:sequenceFlow id="F13" sourceRef="G_Merge" targetRef="T_FormTasks" />
      <bpmn:sequenceFlow id="F14" sourceRef="T_FormTasks" targetRef="T_Create" />
      <bpmn:sequenceFlow id="F15" sourceRef="T_Create" targetRef="T_Rights" />
      <bpmn:sequenceFlow id="F16" sourceRef="T_Rights" targetRef="T_Members" />
      <bpmn:sequenceFlow id="F17" sourceRef="T_Members" targetRef="T_Complete" />
      <bpmn:sequenceFlow id="F18" sourceRef="T_Complete" targetRef="T_Verify" />
      <bpmn:sequenceFlow id="F19" sourceRef="T_Verify" targetRef="G_Verif" />
      <bpmn:sequenceFlow id="F20" name="trouvée (AD ou O365)" sourceRef="G_Verif" targetRef="T_Resolve" />
      <bpmn:sequenceFlow id="F21" name="permission Graph manquante" sourceRef="G_Verif" targetRef="T_Perm" />
      <bpmn:sequenceFlow id="F22" name="introuvable" sourceRef="G_Verif" targetRef="T_Create" />
      <bpmn:sequenceFlow id="F23" sourceRef="T_Perm" targetRef="T_Verify" />
      <bpmn:sequenceFlow id="F24" sourceRef="T_Resolve" targetRef="G_Prov" />
      <bpmn:sequenceFlow id="F25" name="non" sourceRef="G_Prov" targetRef="E_Ok" />
      <bpmn:sequenceFlow id="F26" name="oui" sourceRef="G_Prov" targetRef="T_Watch" />
      <bpmn:sequenceFlow id="F27" sourceRef="T_Watch" targetRef="E_Timer" />
      <bpmn:sequenceFlow id="F28" sourceRef="E_Timer" targetRef="T_Archive" />
      <bpmn:sequenceFlow id="F29" sourceRef="T_Archive" targetRef="T_Del" />
      <bpmn:sequenceFlow id="F30" sourceRef="T_Del" targetRef="E_Arch" />
      <bpmn:dataStoreReference id="App_DSIHub" name="DSI Hub" dsi:applicationId="158" />
      <bpmn:dataStoreReference id="App_Outlook" name="Outlook 365 Web Access" dsi:applicationId="76" />
      <bpmn:dataStoreReference id="App_AD" name="AD (Active Directory)" dsi:applicationId="160" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="4660" height="1075" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="190" y="80" width="4630" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="190" y="295" width="4630" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="190" y="510" width="4630" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="190" y="725" width="4630" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="190" y="940" width="4630" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="292" y="137" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Form_di" bpmnElement="T_Form"><dc:Bounds x="430" y="120" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Ticket_di" bpmnElement="T_Ticket"><dc:Bounds x="620" y="335" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Fiche_di" bpmnElement="T_Fiche"><dc:Bounds x="810" y="335" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Arb_di" bpmnElement="G_Arb" isMarkerVisible="true"><dc:Bounds x="1045" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_ArbTask_di" bpmnElement="T_ArbTask"><dc:Bounds x="1190" y="335" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Decide_di" bpmnElement="T_Decide"><dc:Bounds x="1380" y="550" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Record_di" bpmnElement="T_Record"><dc:Bounds x="1570" y="335" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Pos_di" bpmnElement="G_Pos" isMarkerVisible="true"><dc:Bounds x="1805" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Refus_di" bpmnElement="T_Refus"><dc:Bounds x="1950" y="980" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Refus_di" bpmnElement="E_Refus"><dc:Bounds x="2192" y="997" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Merge_di" bpmnElement="G_Merge" isMarkerVisible="true"><dc:Bounds x="1995" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_FormTasks_di" bpmnElement="T_FormTasks"><dc:Bounds x="2140" y="335" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Create_di" bpmnElement="T_Create"><dc:Bounds x="2330" y="765" width="140" height="70" /></bpmndi:BPMNShape>
