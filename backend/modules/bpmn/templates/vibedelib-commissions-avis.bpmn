<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="VibeDélib — Commissions pour avis : mise à disposition, réunion et avis" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Après la validation du DGS (ou du SCC, au choix), les actes ayant des commissions pour avis sont mis à disposition des membres, présentés en réunion, puis chaque commission rend son avis (favorable, défavorable, réservé, sans avis) qui est joint au dossier du Conseil. Un acte hors commission passe directement à l'ordre du jour ; un acte renvoyé au rédacteur suspend la mise à disposition. Reconstitué à partir du manifeste de VibeDélib (section 15).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="SCC">
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Secrétaire de commission">
        <bpmn:flowNodeRef>T_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Avis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>App_Teams</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Membres de la commission (élus)">
        <bpmn:flowNodeRef>T_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reunion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="VibeDélib (système)">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Hors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Mad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Notif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Convoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Still</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Susp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Susp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Acte validé par le DGS (ou le SCC)">
      <bpmn:documentation>Le déclencheur de la mise à disposition est paramétrable (CMN-04).</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Comm" name="Commissions pour avis ?">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Hors" name="Hors commission : directement à l'ordre du jour">
      <bpmn:documentation>Un acte hors commission ne passe pas par la mise à disposition (CMN-05).</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Mad" name="Mettre à disposition (dossier complet en PDF)">
      <bpmn:documentation>Mise à disposition en lecture seule dans l'espace de la commission, avec version et preuve horodatée (MAD-01, MAD-06).</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Notif" name="Prévenir les membres par mail avec lien">
      <bpmn:documentation>Courriel via APM avec lien personnel vers l'espace élus.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Plan" name="Planifier la réunion et inscrire les projets">
      <bpmn:documentation>Date, lieu, durée, lien Teams (créé automatiquement ou collé) ; les projets mis à disposition de la commission s'inscrivent à l'ordre du jour sans changer le statut de l'acte (REU-01, REU-02, REU-05).</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_App_Teams"><bpmn:targetRef>App_Teams</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Convoc" name="Convoquer membres et secrétaires (rappel à J-2)">
      <bpmn:documentation>Mail à la planification, à chaque modification et à l'annulation, avec rappel à J-2 ouvrés (REU-03).</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Consult" name="Consulter les projets (lecture seule)">
      <bpmn:documentation>Exposé, projet de délibération, annexes communicables ; jamais les commentaires internes ni l'historique du circuit (MAD-03).</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Reunion" name="Examiner les projets en réunion">
      <bpmn:documentation>Les dossiers simples (nom, description, pièces jointes) peuvent compléter l'ordre du jour (COM-02).</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Avis" name="Saisir l'avis de la commission">
      <bpmn:documentation>Favorable, défavorable, réservé ou sans avis, avec commentaire ; sans date, l'avis prend la date de la réunion (REU-04).</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Still" name="Projet toujours validé ?">
      <bpmn:documentation>CMN-07 : si l'acte a été refusé et renvoyé au rédacteur après la mise à disposition, elle est suspendue.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Join" name="Joindre l'avis au dossier du Conseil et prévenir le circuit">
      <bpmn:documentation>L'avis est visible de tout le circuit et joint au dossier du Conseil (section 15.2).</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Done" name="Avis rendu : prêt pour l'ordre du jour">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Susp" name="Suspendre la mise à disposition et prévenir les membres">
      <bpmn:documentation>Les membres sont prévenus ; la mise à disposition reprendra après une nouvelle validation.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Susp" name="Mise à disposition suspendue">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="G_Comm" />
    <bpmn:sequenceFlow id="F02" sourceRef="G_Comm" targetRef="T_Mad" name="Oui" />
    <bpmn:sequenceFlow id="F03" sourceRef="G_Comm" targetRef="E_Hors" name="Non" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_Mad" targetRef="T_Notif" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_Notif" targetRef="T_Plan" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_Plan" targetRef="T_Convoc" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_Convoc" targetRef="T_Consult" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_Consult" targetRef="T_Reunion" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_Reunion" targetRef="T_Avis" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Avis" targetRef="G_Still" />
    <bpmn:sequenceFlow id="F11" sourceRef="G_Still" targetRef="T_Join" name="Oui" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_Still" targetRef="T_Susp" name="Non" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Join" targetRef="E_Done" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Susp" targetRef="E_Susp" />
    <bpmn:dataStoreReference id="App_Teams" name="TEAMS (mode Web)" dsi:applicationId="80" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2440" height="860" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="190" y="80" width="2410" height="160" /></bpmndi:BPMNShape>
