<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Entretiens professionnels — Parcours complet d'un CREP (saisie à la main ou dans l'outil, signatures, clôture)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Parcours complet d'un compte rendu d'entretien professionnel (CREP) dans MagApp. Le valideur choisit dès le début si le CREP est tenu à la main (impression, signatures, téléversement du document signé, lecture automatique, vérification, clôture) ou dans l'outil (saisie, validation de la partie évaluateur, impression, signatures, téléversement, vérification des 2 cadres de l'agent et des signatures, clôture). Il peut changer de mode à tout moment. Après validation, tout est en lecture seule ; l'original signé est transmis à la RH ; seuls les administrateurs peuvent dévalider un CREP (erreur manifeste) ; une fois la campagne close (action « Clore la campagne »), le CREP est consulté dans le dossier de l'agent. Fonctions activables (désactivées par défaut) : préparation de l'agent dans « Mon entretien », signature électronique par parapheur, aides IA à la rédaction et à la relecture.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Administrateur du module">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Desig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Devalider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Clore</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Valideur (évaluateur)">
        <bpmn:flowNodeRef>T_Agents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RDV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Convoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ImpM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EntM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ContreM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VerifM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Saisie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValEv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ImpO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ContreO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VerifO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cloture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RH</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Agent évalué">
        <bpmn:flowNodeRef>T_Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SignAM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SignAO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="MagApp (système)">
        <bpmn:flowNodeRef>T_Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_LectM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_LectO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Dossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Ressources humaines (RH)">
        <bpmn:flowNodeRef>T_RHrec</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Campagne ouverte">
      <bpmn:documentation id="Doc_S1">La campagne d'entretiens professionnels est ouverte (réglage Paramétrage → Campagnes). Le module est en BETA ou publié.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Desig" name="Désigner les valideurs et rattacher les agents">
      <bpmn:documentation id="Doc_T_Desig">L'administrateur désigne les valideurs (directeurs, DGA, DG, sous-valideurs) et la base des agents. Un agent = un seul valideur. Le lien avec l'annuaire (AD) fournit les adresses e-mail.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Agents" name="Vérifier ses agents (ajouter, changer de valideur, lier l'AD)">
      <bpmn:documentation id="Doc_T_Agents">Le valideur retrouve ses agents dans « EP que je réalise ». Il peut ajouter un agent, changer le valideur d'un agent, ou relier un agent sans e-mail à son compte AD (orthographes différentes entre la base RH et l'annuaire).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RDV" name="Prendre rendez-vous (facultatif)">
      <bpmn:documentation id="Doc_T_RDV">Étape facultative : le valideur peut fixer la date « à l'ancienne ». L'assistant de planification n'est qu'une aide (recherche de créneaux communs, convocation par e-mail).</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Mail" name="L'agent a-t-il une adresse e-mail ?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Mail" name="Envoyer l'invitation Outlook et le CREP vierge par e-mail">
      <bpmn:documentation id="Doc_T_Mail">Si l'assistant de planification est utilisé : invitation Outlook, e-mail avec le CREP vierge en PDF. Aucun mail aux agents hors BETA tant que la fonctionnalité n'est pas publiée.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Convoc" name="Convoquer l'agent par un autre moyen (vive voix, téléphone, courrier)">
      <bpmn:documentation id="Doc_T_Convoc">Sans adresse e-mail, aucune convocation ne peut partir : le valideur doit de toute façon convoquer l'agent et lui remettre le CREP vierge imprimé.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Join1">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Prep" name="Préparer son entretien dans « Mon entretien » (fonction activable)">
      <bpmn:documentation id="Doc_T_Prep">Fonction activable (désactivée par défaut) : l'agent prépare sa fiche en ligne ; son valideur la retrouve avant l'entretien. Sinon, préparation sur le CREP vierge papier.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Mode" name="Mode de saisie du CREP ?">
      <bpmn:documentation id="Doc_G_Mode">Dès l'ouverture du CREP, l'outil demande si le compte rendu sera tenu à la main ou dans l'outil. Le choix est modifiable à tout moment (jusqu'à la clôture) ; une remise à zéro de l'entretien ramène à ce choix. Un fil d'Ariane indique l'étape en cours.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ImpM" name="Imprimer le CREP vierge">
      <bpmn:documentation id="Doc_T_ImpM">Mode manuscrit : le valideur imprime le CREP.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_EntM" name="Mener l'entretien : CREP rempli à la main">
      <bpmn:documentation id="Doc_T_EntM">L'entretien a lieu ; le CREP est rempli à la main.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_SignAM" name="Renseigner ses 2 cadres et signer à la main">
      <bpmn:documentation id="Doc_T_SignAM">L'agent renseigne les 2 cadres qui le concernent (conditions de travail, entretien) et signe.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ContreM" name="Contresigner">
      <bpmn:documentation id="Doc_T_ContreM">Le valideur contresigne le CREP.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_UpM" name="Numériser et téléverser le CREP signé (scan ou photos)">
      <bpmn:documentation id="Doc_T_UpM">Le valideur numérise les pages (scan ou photos) et les téléverse via « Importer un compte rendu papier ». Possible tant que l'EP n'est pas validé ; le document téléversé reste consultable.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_LectM" name="Lire le document : textes, cases cochées, identité et 2 signatures">
      <bpmn:documentation id="Doc_T_LectM">Lecture en tâche de fond (plusieurs minutes, e-mail à la fin avec lien direct vers la proposition). Lecture des textes et des cases cochées de la grille, relevé de l'identité de l'agent, détection des 2 signatures. Si le document est celui d'un autre agent ou d'un autre formulaire : confirmation explicite demandée.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_VerifM" name="Vérifier toutes les rubriques (dans l'ordre du CREP) et confirmer les 2 signatures">
      <bpmn:documentation id="Doc_T_VerifM">Le valideur relit et corrige toutes les rubriques, page par page, avec la grille présentée comme sur le CREP ; il coche « J'ai vérifié chaque ligne » et confirme la présence des signatures de l'agent et de l'évaluateur.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Saisie" name="Mener l'entretien puis saisir la grille et les rubriques">
      <bpmn:documentation id="Doc_T_Saisie">Mode outil : saisie des rubriques et de la grille d'appréciation dans l'outil. Les rubriques manquantes qui empêchent la validation sont listées dans une boîte de dialogue.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ValEv" name="Valider la partie évaluateur (champs en lecture seule)">
      <bpmn:documentation id="Doc_T_ValEv">La validation de la partie évaluateur passe tous les champs en lecture seule et retire les boutons de saisie.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ImpO" name="Imprimer le CREP">
      <bpmn:documentation id="Doc_T_ImpO">Impression du CREP saisi, pour signature.</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_SignAO" name="Renseigner ses 2 cadres et signer à la main">
      <bpmn:documentation id="Doc_T_SignAO">L'agent saisit ses 2 cadres à la main et signe.</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ContreO" name="Contresigner">
      <bpmn:documentation id="Doc_T_ContreO">Le valideur contresigne.</bpmn:documentation>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_UpO" name="Numériser et téléverser le CREP signé">
      <bpmn:documentation id="Doc_T_UpO">Téléversement du CREP signé (scan ou photos).</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_LectO" name="Lire les 2 cadres de l'agent et détecter les 2 signatures">
      <bpmn:documentation id="Doc_T_LectO">Seuls les 2 commentaires manuscrits de l'agent (dernière page) sont lus ; le reste du CREP, déjà validé, n'est pas modifié.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_VerifO" name="Vérifier les 2 cadres de l'agent et confirmer les 2 signatures">
      <bpmn:documentation id="Doc_T_VerifO">Le valideur vérifie les 2 cadres de l'agent et confirme la présence des 2 signatures.</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Merge">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Cloture" name="Clôturer l'entretien (validation du CREP, archivage du CREP signé)">
      <bpmn:documentation id="Doc_T_Cloture">Bouton « Clôturer l'entretien » : le CREP est validé si ce n'est pas fait, le document signé vérifié devient le CREP signé archivé, l'entretien est clôturé.</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Lock" name="Lecture seule ; rappel : original signé à transmettre à la RH">
      <bpmn:documentation id="Doc_T_Lock">Une fois le CREP validé, tout est en lecture seule. L'outil rappelle que l'original signé doit être transmis à la RH. Les documents restent consultables jusqu'à la clôture de la campagne.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Err" name="Erreur manifeste ?">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RH" name="Transmettre l'original signé à la RH">
      <bpmn:documentation id="Doc_T_RH">Dans tous les cas, l'ORIGINAL papier signé est envoyé à la RH ; le document numérique est non contractuel.</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Devalider" name="Dévalider le CREP (administrateur, motif obligatoire)">
      <bpmn:documentation id="Doc_T_Devalider">Seuls les administrateurs peuvent « dévalider » un CREP, en cas d'erreur manifeste et tant que la campagne n'est pas close. Le CREP redevient modifiable ; retour au choix du mode de saisie.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RHrec" name="Recevoir et classer l'original signé">
      <bpmn:documentation id="Doc_T_RHrec">La RH reçoit et classe l'original signé.</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Clore" name="Clore la campagne (administrateur)">
      <bpmn:documentation id="Doc_T_Clore">Action « Clore la campagne » (Paramétrage). Les valideurs ne consultent plus les documents dans ce module.</bpmn:documentation>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Dossier" name="CREP consultable dans le dossier de l'agent">
      <bpmn:documentation id="Doc_T_Dossier">Une fois la campagne close, le CREP est consulté dans le dossier de l'agent.</bpmn:documentation>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_End" name="Entretien archivé">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S1" targetRef="T_Desig" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_Desig" targetRef="T_Agents" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Agents" targetRef="T_RDV" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_RDV" targetRef="G_Mail" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="G_Mail" targetRef="T_Mail" name="oui" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G_Mail" targetRef="T_Convoc" name="non" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_Mail" targetRef="G_Join1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_Convoc" targetRef="G_Join1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G_Join1" targetRef="T_Prep" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_Prep" targetRef="G_Mode" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="G_Mode" targetRef="T_ImpM" name="à la main" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="G_Mode" targetRef="T_Saisie" name="dans l'outil" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T_ImpM" targetRef="T_EntM" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T_EntM" targetRef="T_SignAM" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T_SignAM" targetRef="T_ContreM" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T_ContreM" targetRef="T_UpM" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T_UpM" targetRef="T_LectM" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T_LectM" targetRef="T_VerifM" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T_VerifM" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T_Saisie" targetRef="T_ValEv" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T_ValEv" targetRef="T_ImpO" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T_ImpO" targetRef="T_SignAO" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T_SignAO" targetRef="T_ContreO" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="T_ContreO" targetRef="T_UpO" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="T_UpO" targetRef="T_LectO" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="T_LectO" targetRef="T_VerifO" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="T_VerifO" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="G_Merge" targetRef="T_Cloture" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="T_Cloture" targetRef="T_Lock" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="T_Lock" targetRef="G_Err" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="G_Err" targetRef="T_RH" name="non" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="G_Err" targetRef="T_Devalider" name="oui" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="T_Devalider" targetRef="G_Mode" name="retour au choix du mode" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="T_RH" targetRef="T_RHrec" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="T_RHrec" targetRef="T_Clore" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="T_Clore" targetRef="T_Dossier" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="T_Dossier" targetRef="E_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
