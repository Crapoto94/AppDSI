<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Résolution d'un incident" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Cycle de vie complet d'un incident, de ses quatre entrées (formulaire / MagApp, e-mail O365, chat en direct, appel ou passage) à sa clôture : création et qualification automatiques (SLA, règles, VIP, crise Teams), prise en charge, cas particuliers (compte AD, information manquante avec relances, hors compétence, panne collective avec Problème), résolution, réouverture, satisfaction et clôtures automatiques. Reconstitué à partir du code et des guides du module Tickets d'AppDSI.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
        <bpmn:lane id="Lane_0" name="Usager / Demandeur">
          <bpmn:flowNodeRef>S_Form</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_FormFill</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_Mail</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_Chat</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Resp</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Reopen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Confirm</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_1" name="Canaux d'entrée (système)">
          <bpmn:flowNodeRef>T_MailDedup</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Reply</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Classify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_AddComment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Comment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Hours</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_ChatTicket</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Urgence</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_SMS</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_2" name="AppDSI (règles, SLA, notifications)">
          <bpmn:flowNodeRef>T_Create</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_SLA</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Rules</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Crit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Crisis</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Assigned</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Evt</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Timer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Remind</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Keep</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Keep</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_AutoClose7</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Auto7</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_NotifySol</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Evt2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Delay</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_UserClose</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_AutoClose6</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Sat</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_DSIHub</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_Teams</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_3" name="Technicien (hot-line N1)">
          <bpmn:flowNodeRef>S_Phone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Claim</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Talk</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_ChatDone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_ChatClassify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_ChatDone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Reject</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Reject</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Take</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Diag</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Nature</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Fix</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Wait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Escal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Problem</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Fast</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Resume</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Resolve</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Reopen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_AD</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_DSIHub2</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_4" name="Groupes experts (N2, prestataire)">
          <bpmn:flowNodeRef>T_N2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_N2</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_5" name="Superviseur">
          <bpmn:flowNodeRef>T_Triage</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_ProbSolve</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Cascade</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="S_Form" name="Incident rencontré (formulaire)">
        <bpmn:documentation>Entrée 1 — saisie par l'usager : bouton « Nouveau ticket » ou demande déposée depuis le Magasin d'applications (source magapp), en lien avec une application.</bpmn:documentation>
        <bpmn:outgoing>F001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_FormFill" name="Déposer la demande (Nouveau ticket / MagApp)">
        <bpmn:documentation>Champs du formulaire : type (Incident ou Demande, obligatoire), titre (obligatoire), description (éditeur enrichi, captures), priorité, impact (ampleur : nombre d'usagers), catégorie / sous-catégorie, logiciel / métier (application), localisation (référentiel des sites), VIP, demandeur, observateurs, pièces jointes.</bpmn:documentation>
        <bpmn:incoming>F001</bpmn:incoming>
        <bpmn:outgoing>F002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:startEvent id="S_Mail" name="E-mail au support">
        <bpmn:documentation>Entrée 2 — l'usager écrit à une boîte O365 surveillée par le Mail Collector.</bpmn:documentation>
        <bpmn:outgoing>F003</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:startEvent id="S_Chat" name="Chat en direct">
        <bpmn:documentation>Entrée 3 — l'usager ouvre une session depuis la bulle de chat (portail MagApp / hub).</bpmn:documentation>
        <bpmn:outgoing>F009</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:startEvent id="S_Phone" name="Appel ou passage à la hot-line">
        <bpmn:documentation>Entrée 4 — demande orale, téléphonique ou en personne : le technicien saisit le ticket à la place de l'usager.</bpmn:documentation>
        <bpmn:outgoing>F021</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_Manual" name="Saisir le ticket à la place de l'usager">
        <bpmn:documentation>Même formulaire que la saisie manuelle, avec le champ « Demandeur » renseigné pour la personne concernée (recherche AD), plus observateurs. Le numéro de téléphone du demandeur est mémorisé sur son profil pour les prochaines saisies.</bpmn:documentation>
        <bpmn:incoming>F021</bpmn:incoming>
        <bpmn:outgoing>F022</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_MailDedup" name="Collecter l'e-mail (anti-doublon, filtre de domaine)">
        <bpmn:documentation>Mail Collector (planifié) : lecture des boîtes O365 via Microsoft Graph. Un message déjà traité (internetMessageId présent dans ticket_email_mapping) est ignoré ; un filtre de domaine optionnel écarte les expéditeurs externes. Deux collectes simultanées sont protégées par un enregistrement atomique (ON CONFLICT).</bpmn:documentation>
        <bpmn:incoming>F003</bpmn:incoming>
        <bpmn:outgoing>F004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Reply" name="Réponse à un ticket existant ?">
        <bpmn:documentation>Détection par les en-têtes In-Reply-To / References, puis par l'objet préfixé RE / TR / FW / Fwd.</bpmn:documentation>
        <bpmn:incoming>F004</bpmn:incoming>
        <bpmn:outgoing>F005</bpmn:outgoing>
        <bpmn:outgoing>F006</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Classify" name="Classer Incident / Demande (règles de mail)">
        <bpmn:documentation>Nouveau ticket : classification Incident / Demande par les règles de mail (mail_rules), catégorie et routage éventuels. Objet = titre, corps = description, expéditeur = demandeur, copies (CC) = observateurs, pièces jointes téléchargées (y compris images inline cid: même si hasAttachments est faux).</bpmn:documentation>
        <bpmn:incoming>F006</bpmn:incoming>
        <bpmn:outgoing>F008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_AddComment" name="Ajouter comme commentaire (+ CC, pièces jointes)">
        <bpmn:documentation>La réponse devient un commentaire du ticket existant ; les personnes en copie deviennent observateurs ; les images inline sont réécrites vers les pièces jointes du ticket.</bpmn:documentation>
        <bpmn:incoming>F005</bpmn:incoming>
        <bpmn:outgoing>F007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_Comment" name="Commentaire ajouté au ticket">
        <bpmn:incoming>F007</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G_Hours" name="Chat ouvert ?">
        <bpmn:documentation>Le chat suit le calendrier du support : horaires ouvrés, jours fériés et fermetures exceptionnelles (la bulle est alors grisée).</bpmn:documentation>
        <bpmn:incoming>F009</bpmn:incoming>
        <bpmn:outgoing>F010</bpmn:outgoing>
        <bpmn:outgoing>F011</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_ChatTicket" name="Créer la session de chat et son ticket">
        <bpmn:documentation>live_sessions (statut waiting) + ticket associé. Les techniciens voient la session dans la vue Live (temps réel) ; un groupe peut être notifié (ex. chat école).</bpmn:documentation>
        <bpmn:incoming>F010</bpmn:incoming>
        <bpmn:outgoing>F013</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Urgence" name="Message d'urgence : SMS à l'astreinte">
        <bpmn:documentation>Cas particulier hors horaires / jour férié : l'usager peut envoyer un message d'urgence (nom, problème, numéro de mobile valide 06/07 ou +33 6/7) ; AppDSI envoie un SMS à l'astreinte (numéro configuré dans /admin/tickets) et le trace (hub.sms_logs).</bpmn:documentation>
        <bpmn:incoming>F011</bpmn:incoming>
        <bpmn:outgoing>F012</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_SMS" name="Astreinte alertée">
        <bpmn:incoming>F012</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_Claim" name="Prendre en charge la session de chat">
        <bpmn:documentation>Un technicien prend la session (statut active). Une session déjà prise n'est reprise que de force.</bpmn:documentation>
        <bpmn:incoming>F013</bpmn:incoming>
        <bpmn:outgoing>F014</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Talk" name="Échanger avec l'usager">
        <bpmn:documentation>Messages et pièces jointes dans la session. Inactivité de 15 minutes ou départ de l'usager : la session passe en pré-clôture (pre_closed), à finaliser par le technicien.</bpmn:documentation>
        <bpmn:incoming>F014</bpmn:incoming>
        <bpmn:outgoing>F015</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_ChatDone" name="Issue du chat ?">
        <bpmn:incoming>F015</bpmn:incoming>
        <bpmn:outgoing>F016</bpmn:outgoing>
        <bpmn:outgoing>F018</bpmn:outgoing>
        <bpmn:outgoing>F020</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_ChatClassify" name="Classer Incident / Demande puis finaliser">
        <bpmn:documentation>La classification Incident / Demande est OBLIGATOIRE avant clôture. Le ticket est clos (statut Clos), un résumé de la conversation (modèle configurable) est conservé et envoyé.</bpmn:documentation>
        <bpmn:incoming>F016</bpmn:incoming>
        <bpmn:outgoing>F017</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_ChatDone" name="Résolu en chat (ticket clos)">
        <bpmn:incoming>F017</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_Reject" name="Rejeter la session">
        <bpmn:documentation>Faux appel, test ou doublon : le ticket créé automatiquement passe à « Rejeté » (statut 8, suppression logique) et la session est close (close_reason = rejected).</bpmn:documentation>
        <bpmn:incoming>F018</bpmn:incoming>
        <bpmn:outgoing>F019</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_Reject" name="Session rejetée (statut 8)">
        <bpmn:incoming>F019</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_Create" name="Créer le ticket (statut Nouveau)">
        <bpmn:documentation>Quelle que soit l'entrée, le ticket rejoint la même file. Entrées : type (Incident par défaut), titre, contenu, priorité / urgence / impact, catégorie, application, localisation, demandeur (nom, email, téléphone), observateurs, source (manuel, magapp, mail, live). Historique « created » écrit ; statut 1 = Nouveau.</bpmn:documentation>
        <bpmn:incoming>F002</bpmn:incoming>
        <bpmn:incoming>F008</bpmn:incoming>
        <bpmn:incoming>F022</bpmn:incoming>
        <bpmn:outgoing>F023</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_DSIHub"><bpmn:targetRef>App_DSIHub</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_SLA" name="Appliquer le SLA (heures ouvrées)">
        <bpmn:documentation>SLA choisi selon la priorité et la catégorie ; cibles de première réponse et de résolution calculées en minutes OUVRÉES du calendrier (« 4 h ouvrées » ne courent ni la nuit ni le week-end). Un contrôle périodique alerte à 90 % (sla_warning) et trace le dépassement (sla_breached, historique + notification).</bpmn:documentation>
        <bpmn:incoming>F023</bpmn:incoming>
        <bpmn:outgoing>F024</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Rules" name="Appliquer les règles d'affectation (VIP, priorité, type, catégorie)">
        <bpmn:documentation>Règles actives appliquées en cascade, de la plus spécifique à la plus générale : set_vip, boost_priority (+1, plafonné à 5), set_type, set_category, add_tag, puis affectation à un technicien ou à un GROUPE (file d'attente du groupe, sans technicien désigné). Le demandeur est aussi comparé à la liste VIP (nom normalisé ou email).</bpmn:documentation>
        <bpmn:incoming>F024</bpmn:incoming>
        <bpmn:outgoing>F025</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Crit" name="Urgence et impact élevés ?">
        <bpmn:documentation>Critères de crise définis dans la configuration Teams (urgence + impact).</bpmn:documentation>
        <bpmn:incoming>F025</bpmn:incoming>
        <bpmn:outgoing>F026</bpmn:outgoing>
        <bpmn:outgoing>F027</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Crisis" name="Alerter l'équipe sur Teams">
        <bpmn:documentation>Carte envoyée au webhook Teams (si activé) ; un message de résolution est aussi envoyé quand le ticket de crise est résolu.</bpmn:documentation>
        <bpmn:incoming>F026</bpmn:incoming>
        <bpmn:outgoing>F028</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_Teams"><bpmn:targetRef>App_Teams</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Notify" name="Notifier (accusé au demandeur, groupe, technicien)">
        <bpmn:documentation>Déclencheur ticket.created : modèles de mail par destinataire (demandeur, technicien, groupe, observateurs, admins) selon le paramétrage des Déclencheurs et Templates.</bpmn:documentation>
        <bpmn:incoming>F027</bpmn:incoming>
        <bpmn:incoming>F028</bpmn:incoming>
        <bpmn:outgoing>F029</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Assigned" name="Affecté par une règle ?">
        <bpmn:incoming>F029</bpmn:incoming>
        <bpmn:outgoing>F030</bpmn:outgoing>
        <bpmn:outgoing>F031</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Triage" name="Trier et affecter le ticket">
        <bpmn:documentation>Aucune règle ne correspond : le ticket reste Nouveau et non affecté ; le superviseur (ou la hot-line) le qualifie et l'affecte à un technicien ou à un groupe.</bpmn:documentation>
        <bpmn:incoming>F031</bpmn:incoming>
        <bpmn:outgoing>F032</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Take" name="Prendre en charge (En cours) et s'assigner">
        <bpmn:documentation>Nouveau → En cours (statut 2 attribué, ou 3 planifié). L'assignation est tracée dans l'historique ; un technicien membre du groupe par défaut rattache aussi le ticket à ce groupe.</bpmn:documentation>
        <bpmn:incoming>F030</bpmn:incoming>
        <bpmn:incoming>F032</bpmn:incoming>
        <bpmn:outgoing>F033</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Diag" name="Diagnostiquer">
        <bpmn:documentation>Qualifier (catégorie, logiciel, localisation), commenter, créer des tâches (aussi visibles dans Mes Tâches). Aides à la fiche : documents MagApp de l'application (joignables en un clic), articles de la base documentaire, réponses types, équipements du demandeur dans le Parc (rapprochés par email), historique, reformulation IA des commentaires.</bpmn:documentation>
        <bpmn:incoming>F020</bpmn:incoming>
        <bpmn:incoming>F033</bpmn:incoming>
        <bpmn:incoming>F053</bpmn:incoming>
        <bpmn:incoming>F057</bpmn:incoming>
        <bpmn:incoming>F067</bpmn:incoming>
        <bpmn:outgoing>F034</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_Nature" name="Nature du cas ?">
        <bpmn:incoming>F034</bpmn:incoming>
        <bpmn:outgoing>F035</bpmn:outgoing>
        <bpmn:outgoing>F036</bpmn:outgoing>
        <bpmn:outgoing>F037</bpmn:outgoing>
        <bpmn:outgoing>F038</bpmn:outgoing>
        <bpmn:outgoing>F039</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Fix" name="Traiter (documents MagApp, parc, base documentaire)">
        <bpmn:documentation>Cas standard : le technicien applique la procédure ou la solution connue.</bpmn:documentation>
        <bpmn:incoming>F035</bpmn:incoming>
        <bpmn:outgoing>F040</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Wait" name="Passer « En attente » (motif ; SLA en pause)">
        <bpmn:documentation>Cas « information manquante » : statut 4 En attente avec motif d'attente. Le SLA est SUSPENDU et le temps d'attente est cumulé à part (total_waiting_seconds) ; il reprend à la sortie de l'attente.</bpmn:documentation>
        <bpmn:incoming>F036</bpmn:incoming>
        <bpmn:outgoing>F042</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Escal" name="Escalader vers un groupe (N2, expert, prestataire)">
        <bpmn:documentation>Cas « hors compétence N1 » : fenêtre d'assignation, onglet Escalade vers un groupe. Toute (ré)assignation et escalade est tracée.</bpmn:documentation>
        <bpmn:incoming>F037</bpmn:incoming>
        <bpmn:outgoing>F054</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Problem" name="Créer ou associer un Problème">
        <bpmn:documentation>Cas « panne collective » (mêmes symptômes) : créer un Problème à partir du ticket ou l'associer à un Problème existant. Il porte une méthode de résolution et peut citer un article de connaissance.</bpmn:documentation>
        <bpmn:incoming>F038</bpmn:incoming>
        <bpmn:outgoing>F058</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_Fast" name="Action rapide : déverrouiller, réinitialiser (SMS), forcer le changement">
        <bpmn:documentation>Cas « compte AD / mot de passe » — module Actions rapides (/fast) : recherche du compte AD, déverrouillage, activation/désactivation, mot de passe provisoire envoyé par SMS au bénéficiaire, ou obligation de changer le mot de passe à la prochaine connexion. Un ticket « changement de mot de passe » peut être créé.</bpmn:documentation>
        <bpmn:incoming>F039</bpmn:incoming>
        <bpmn:outgoing>F041</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_AD"><bpmn:targetRef>App_AD</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:eventBasedGateway id="G_Evt">
        <bpmn:documentation>Deux événements possibles : réponse du demandeur, ou délai d'inactivité.</bpmn:documentation>
        <bpmn:incoming>F042</bpmn:incoming>
        <bpmn:outgoing>F043</bpmn:outgoing>
        <bpmn:outgoing>F044</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="E_Resp" name="Réponse du demandeur (mail ou lien)">
        <bpmn:documentation>Par email (rattaché au ticket par le Mail Collector), ou depuis le lien « Répondre » (/repondre/{jeton}) des mails du support.</bpmn:documentation>
        <bpmn:incoming>F043</bpmn:incoming>
        <bpmn:outgoing>F045</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_E_Resp" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="E_Timer" name="Inactivité du ticket">
        <bpmn:documentation>Résolution automatique (relances) : délai d'inactivité configurable en jours.</bpmn:documentation>
        <bpmn:incoming>F044</bpmn:incoming>
        <bpmn:incoming>F049</bpmn:incoming>
        <bpmn:outgoing>F046</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_E_Timer" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="T_Remind" name="Envoyer une relance (« toujours d'actualité ? »)">
        <bpmn:documentation>Mail de relance avec bouton « Mon ticket est toujours d'actualité » (lien à jeton unique). Nombre maximal de relances et fréquence configurables (par défaut 3 relances, tous les 7 jours) ; observateurs prévenus si l'option est active.</bpmn:documentation>
        <bpmn:incoming>F046</bpmn:incoming>
        <bpmn:outgoing>F047</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Keep" name="Réponse à la relance ?">
        <bpmn:incoming>F047</bpmn:incoming>
        <bpmn:outgoing>F048</bpmn:outgoing>
        <bpmn:outgoing>F049</bpmn:outgoing>
        <bpmn:outgoing>F050</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Keep" name="Commentaire ajouté, priorité +1">
        <bpmn:documentation>Le demandeur confirme : son commentaire est ajouté au ticket, la priorité est augmentée d'un niveau (max 5) et un mail de remerciement est envoyé.</bpmn:documentation>
        <bpmn:incoming>F048</bpmn:incoming>
        <bpmn:outgoing>F052</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_AutoClose7" name="Clôture automatique sans réponse (statut 7)">
        <bpmn:documentation>Après le nombre maximal de relances sans réponse : statut 7, date de clôture, historique « Clôture automatique – aucune réponse après relances » et mail d'information au demandeur (nouveau ticket à créer si besoin).</bpmn:documentation>
        <bpmn:incoming>F050</bpmn:incoming>
        <bpmn:outgoing>F051</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_Auto7" name="Clôturé sans réponse">
        <bpmn:incoming>F051</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_Resume" name="Reprendre (En cours, SLA repris)">
        <bpmn:documentation>Sortie de l'attente : le temps d'attente écoulé est ajouté au cumul, le SLA reprend.</bpmn:documentation>
        <bpmn:incoming>F045</bpmn:incoming>
        <bpmn:incoming>F052</bpmn:incoming>
        <bpmn:outgoing>F053</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_N2" name="Traiter (N2 / expert / prestataire)">
        <bpmn:documentation>Le groupe destinataire traite le ticket (niveau 2, expert ou prestataire) ; les règles d'escalade évitent qu'un ticket stagne sans prise en charge.</bpmn:documentation>
        <bpmn:incoming>F054</bpmn:incoming>
        <bpmn:outgoing>F055</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_N2" name="Résolu par le N2 ?">
        <bpmn:incoming>F055</bpmn:incoming>
        <bpmn:outgoing>F056</bpmn:outgoing>
        <bpmn:outgoing>F057</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_ProbSolve" name="Résoudre le Problème (méthode, article de connaissance)">
        <bpmn:documentation>La clôture d'un ticket de type Problème est RÉSERVÉE aux superviseurs. Résoudre le Problème renseigne la solution et sa méthode.</bpmn:documentation>
        <bpmn:incoming>F058</bpmn:incoming>
        <bpmn:outgoing>F059</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Cascade" name="Résoudre en cascade les tickets liés">
        <bpmn:documentation>resolveProblem avec auto_resolve_linked : tous les tickets liés au Problème sont résolus d'un coup avec la même solution (les échecs éventuels sont remontés).</bpmn:documentation>
        <bpmn:incoming>F059</bpmn:incoming>
        <bpmn:outgoing>F060</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_Resolve" name="Solutionner : solution + statut Résolu">
        <bpmn:documentation>Geste recommandé « Solutionner » : le commentaire est enregistré COMME SOLUTION et le ticket passe à Résolu (statut 5) en une seule action. Entrées : texte de la solution (reformulation IA possible, réponses types), pièces jointes, copie (CC) aux observateurs. Pour un groupe de tickets ou un Problème, l'application propose la résolution en cascade.</bpmn:documentation>
        <bpmn:incoming>F040</bpmn:incoming>
        <bpmn:incoming>F041</bpmn:incoming>
        <bpmn:incoming>F056</bpmn:incoming>
        <bpmn:outgoing>F061</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_DSIHub2"><bpmn:targetRef>App_DSIHub2</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_NotifySol" name="Notifier le demandeur (solution, liens Répondre / Rouvrir)">
        <bpmn:documentation>Mail au demandeur (file de notification, modèle ticket_comment_reply) avec lien « Répondre » et bouton « Rouvrir le ticket » valable 168 h (7 jours). SLA clôturé (ok). Message Teams de résolution pour un ticket de crise.</bpmn:documentation>
        <bpmn:incoming>F060</bpmn:incoming>
        <bpmn:incoming>F061</bpmn:incoming>
        <bpmn:outgoing>F062</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:eventBasedGateway id="G_Evt2">
        <bpmn:documentation>Trois issues possibles après résolution.</bpmn:documentation>
        <bpmn:incoming>F062</bpmn:incoming>
        <bpmn:outgoing>F063</bpmn:outgoing>
        <bpmn:outgoing>F064</bpmn:outgoing>
        <bpmn:outgoing>F065</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="E_Reopen" name="Le demandeur rouvre le ticket (≤ 7 j)">
        <bpmn:documentation>Depuis le bouton du mail (/reouvrir/{jeton}) ou dans l'application. Au-delà de 7 jours : « Délai de réouverture dépassé », il faut créer un nouveau ticket. Un technicien ou superviseur peut rouvrir un ticket résolu, clos ou rejeté sans cette limite.</bpmn:documentation>
        <bpmn:incoming>F063</bpmn:incoming>
        <bpmn:outgoing>F066</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_E_Reopen" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="E_Confirm" name="Le demandeur confirme">
        <bpmn:documentation>Le demandeur clôture lui-même le ticket résolu (source « demandeur » dans le log des clôtures).</bpmn:documentation>
        <bpmn:incoming>F064</bpmn:incoming>
        <bpmn:outgoing>F068</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_E_Confirm" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="E_Delay" name="N jours après résolution (7 par défaut)">
        <bpmn:documentation>Paramètre « Durée avant clôture auto » (0 = désactivé) dans /admin/tickets, onglet Clôture.</bpmn:documentation>
        <bpmn:incoming>F065</bpmn:incoming>
        <bpmn:outgoing>F069</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_E_Delay" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="T_Reopen" name="Rouvrir le ticket (Nouveau ou En cours)">
        <bpmn:documentation>Résolu / Clos / Rejeté → En cours (statut 2) s'il a un technicien ou un groupe, sinon Nouveau (statut 1). Déclencheur ticket.reopened.</bpmn:documentation>
        <bpmn:incoming>F066</bpmn:incoming>
        <bpmn:outgoing>F067</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_UserClose" name="Clôturer (par le demandeur)">
        <bpmn:documentation>Résolu → Clos (statut 6), notification ticket.closed.</bpmn:documentation>
        <bpmn:incoming>F068</bpmn:incoming>
        <bpmn:outgoing>F070</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_AutoClose6" name="Clôture automatique nocturne (statut Clos)">
        <bpmn:documentation>Tâche planifiée de minuit : tout ticket Résolu depuis plus de N jours passe à Clos, tracé dans l'historique (auteur « Système »).</bpmn:documentation>
        <bpmn:incoming>F069</bpmn:incoming>
        <bpmn:outgoing>F071</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Sat" name="Inviter à donner un avis de satisfaction">
        <bpmn:documentation>Enquête de satisfaction (activable dans /admin/tickets) : notes et commentaires consultables par les superviseurs.</bpmn:documentation>
        <bpmn:incoming>F070</bpmn:incoming>
        <bpmn:incoming>F071</bpmn:incoming>
        <bpmn:outgoing>F072</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_End" name="Incident clos">
        <bpmn:incoming>F072</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F001" sourceRef="S_Form" targetRef="T_FormFill" />
