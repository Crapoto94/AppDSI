      <bpmn:sequenceFlow id="F038" name="panne collective" sourceRef="G_Nature" targetRef="T_Problem" />
      <bpmn:sequenceFlow id="F039" name="compte AD / mot de passe" sourceRef="G_Nature" targetRef="T_Fast" />
