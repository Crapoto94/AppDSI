      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1900" y="695" /><di:waypoint x="1947.5" y="695" /><di:waypoint x="1947.5" y="370" /><di:waypoint x="1995" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="2045" y="370" /><di:waypoint x="2092.5" y="370" /><di:waypoint x="2092.5" y="695" /><di:waypoint x="2140" y="695" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="2045" y="370" /><di:waypoint x="2118.5" y="370" /><di:waypoint x="2118.5" y="480" /><di:waypoint x="2192" y="480" /></bpmndi:BPMNEdge>
