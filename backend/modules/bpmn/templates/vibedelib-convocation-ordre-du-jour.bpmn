<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="VibeDélib — Séance du Conseil : ordre du jour, cahier et convocation des élus" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Préparation d'une séance du Conseil municipal par le SCC : création de la séance et de ses dates clés, affectation des actes validés, ordre de passage et numérotation, cahier de séance, ordre du jour arrêté, génération de la convocation avec contrôle du délai légal (5 jours francs, 1 en cas d'urgence motivée), envoi selon le canal de chaque élu, mise à disposition simultanée, réponses de présence et pouvoirs, modificatif éventuel. Reconstitué à partir du manifeste de VibeDélib (sections 16 et 17).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="SCC">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Seance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Affect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Arret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Modif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Modif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="VibeDélib (système)">
        <bpmn:flowNodeRef>T_Cahier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Conv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Delai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Mad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Preuve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Modificatif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Modif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Élus (conseillers)">
        <bpmn:flowNodeRef>T_Rep</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Séance du Conseil à organiser">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Seance" name="Créer la séance et fixer les dates clés">
      <bpmn:documentation>Instance, type (ordinaire, extraordinaire, budgétaire), date, lieu, date limite de rédaction (pré-remplie par un décalage paramétrable) et jalons (SEA-01, SEA-02).</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Affect" name="Affecter les actes validés à l'ordre du jour">
      <bpmn:documentation>La séance visée est proposée par le rédacteur et modifiable par la hiérarchie ; le SCC affecte définitivement. Les actes non affectés restent dans l'onglet « en attente d'affectation » (SEA-04).</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Order" name="Ordonner et numéroter les délibérations">
      <bpmn:documentation>Ordre de passage par glisser-déposer (D10) ; numérotation par séance selon un format entièrement personnalisable (D18).</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Cahier" name="Générer le cahier de séance et la note de synthèse">
      <bpmn:documentation>Cahier de séance unique, prêt à imprimer, avec exposés, projets, annexes et avis de commission (D11) ; note explicative de synthèse (SEA-06).</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Arret" name="Arrêter l'ordre du jour">
      <bpmn:documentation>Précondition de la convocation (CONV-02).</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Conv" name="Générer la convocation et l'ordre du jour (PDF)">
      <bpmn:documentation>Gabarit de mise en page de la collectivité ; statuts brouillon → prête → envoyée → modifiée.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Delai" name="Délai légal respecté (5 jours francs) ?">
      <bpmn:documentation>Contrôle du délai entre l'envoi et la séance ; délai, urgence et mode (blocage ou avertissement) sont paramétrables (CONV-03).</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Urg" name="Motiver l'urgence (1 jour franc) ou décaler l'envoi">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Send" name="Envoyer selon le canal de chaque élu">
      <bpmn:documentation>Mail avec lien sécurisé vers l'espace élus (aucune pièce confidentielle en pièce jointe), SMS d'alerte, ou papier (liste des élus papier, étiquettes) ; consentement daté (CONV-04).</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Mad" name="Mettre à disposition dans l'espace des élus">
      <bpmn:documentation>Tous les membres obtiennent l'accès au même instant (égalité d'information, MAD-02) ; preuve horodatée et versions (MAD-06).</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Rep" name="Répondre : présent, excusé ou pouvoir">
      <bpmn:documentation>Réponses depuis le lien de convocation ; un élu ne peut recevoir qu'un seul pouvoir (CONV-06). Elles pré-remplissent les présences de la séance.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Preuve" name="Enregistrer la preuve d'envoi, les ouvertures et les réponses">
      <bpmn:documentation>Journal envoyé → distribué → lien ouvert → documents consultés → relance ; page de logs et de statistiques de la convocation (CONV-05, LOG-01).</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Modif" name="Point ajouté ou retiré après l'envoi ?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Modif" name="Ajouter ou retirer le point (ordre du jour complémentaire)">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Modificatif" name="Générer le modificatif avec les différences apparentes">
      <bpmn:documentation>Nouvelle version de la convocation, journal et nouvelle preuve d'envoi, contrôle du délai pour les points ajoutés (CONV-07).</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Modif" name="Modificatif envoyé aux élus">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_End" name="Séance prête : suite en séance (présences, votes)">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="T_Seance" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_Seance" targetRef="T_Affect" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_Affect" targetRef="T_Order" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_Order" targetRef="T_Cahier" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_Cahier" targetRef="T_Arret" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_Arret" targetRef="T_Conv" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_Conv" targetRef="G_Delai" />
    <bpmn:sequenceFlow id="F08" sourceRef="G_Delai" targetRef="T_Send" name="Oui" />
    <bpmn:sequenceFlow id="F09" sourceRef="G_Delai" targetRef="T_Urg" name="Non" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Urg" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Send" targetRef="T_Mad" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Mad" targetRef="T_Rep" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Rep" targetRef="T_Preuve" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Preuve" targetRef="G_Modif" />
    <bpmn:sequenceFlow id="F15" sourceRef="G_Modif" targetRef="E_End" name="Non" />
    <bpmn:sequenceFlow id="F16" sourceRef="G_Modif" targetRef="T_Modif" name="Oui" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Modif" targetRef="T_Modificatif" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_Modificatif" targetRef="E_Modif" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="3390" height="700" /></bpmndi:BPMNShape>
