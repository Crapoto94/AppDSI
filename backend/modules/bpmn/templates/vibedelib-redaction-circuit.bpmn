      <bpmndi:BPMNEdge id="F06_di" bpmnElement="F06"><di:waypoint x="1160" y="825" /><di:waypoint x="1160" y="260" /><di:waypoint x="1280" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="1164" y="805" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F07_di" bpmnElement="F07"><di:waypoint x="1420" y="260" /><di:waypoint x="1485" y="260" /><di:waypoint x="1485" y="690" /><di:waypoint x="1515" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F08_di" bpmnElement="F08"><di:waypoint x="1540" y="665" /><di:waypoint x="1540" y="150" /><di:waypoint x="1850" y="150" /><bpmndi:BPMNLabel><dc:Bounds x="1544" y="645" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F09_di" bpmnElement="F09"><di:waypoint x="1540" y="715" /><di:waypoint x="1540" y="960" /><di:waypoint x="1660" y="960" /><bpmndi:BPMNLabel><dc:Bounds x="1544" y="695" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1800" y="960" /><di:waypoint x="1820" y="960" /><di:waypoint x="1820" y="150" /><di:waypoint x="1850" y="150" /></bpmndi:BPMNEdge>
