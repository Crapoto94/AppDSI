<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dsi="http://dsi.ivry/schema/bpmn" id="Definitions_NouvelArrivant" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Accueil informatique d'un nouvel arrivant" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:documentation id="Doc_Process">Processus d'accueil informatique d'un nouvel arrivant, de la demande de l'encadrant à la résolution du ticket : formulaire « Arrivée d'agent » (MagApp / Tickets), onboarding Studio RH, checklist de comptes logiciels, tâches DSI Hub, matériel et rapprochement AD. Reconstitué à partir du code d'AppDSI et de son intégration avec Studio RH.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
        <bpmn:lane id="Lane_Encadrant" name="Encadrant (N+1) / Demandeur">
          <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Form</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Fill</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_AppDSI" name="AppDSI (MagApp, Tickets, Tâches, RH)">
          <bpmn:flowNodeRef>T_Ticket</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Trig</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Ok</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Wait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Prog</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_DsiTasks</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Ack</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_AdSync</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_DSIHub</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_AD2</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Studio" name="Studio RH">
          <bpmn:flowNodeRef>T_Mail</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Gen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Auto</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Hotline" name="Hot-line DSI">
          <bpmn:flowNodeRef>T_Fail</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E_Manual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Mat</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Techs" name="Techniciens (création de comptes)">
          <bpmn:flowNodeRef>T_Accounts</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_AD</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>App_Outlook</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start" name="Arrivée d'un agent à préparer">
        <bpmn:documentation>Déclencheur : un encadrant (N+1) ou un demandeur sait qu'un agent arrive (ou vient d'arriver) et doit être équipé.</bpmn:documentation>
        <bpmn:outgoing>F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_Form" name="Remplir la demande « Arrivée d'agent »">
        <bpmn:documentation>Formulaire de demande paramétrable (portail MagApp / Tickets). Champs à clés fixes : deja_arrive (l'agent est-il déjà arrivé ?), agent_arrive ou futurs_agent (sélecteur alimenté par Studio RH : /agents/search, /onboarding?mode=futurs_actionable) et manager (N+1, obligatoire). Un nouvel agent absent de Studio RH peut être saisi par nom/prénom.</bpmn:documentation>
        <bpmn:incoming>F01</bpmn:incoming>
        <bpmn:outgoing>F02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Ticket" name="Créer le ticket « Arrivée d'agent »">
        <bpmn:documentation>AppDSI crée le ticket (hub_tickets.tickets, identifiant glpi_id) à partir du formulaire. L'email de confirmation au demandeur est différé jusqu'à la fin du déclenchement de l'onboarding (skipNotification).</bpmn:documentation>
        <bpmn:incoming>F02</bpmn:incoming>
        <bpmn:outgoing>F03</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_DSIHub"><bpmn:targetRef>App_DSIHub</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Trig" name="Créer l'onboarding dans Studio RH">
        <bpmn:documentation>POST {studio}/onboarding avec { manager_id, agent_id | nom_temp + prenom_temp, date_arrivee_prevue?, dsihub_ticket_id }. Clé API dédiée « rh_studio_onboarding » (lecture/écriture), distincte de la clé de présence (lecture seule). Code : triggerOnboardingRhStudio (request-forms.controller.js).</bpmn:documentation>
        <bpmn:incoming>F03</bpmn:incoming>
        <bpmn:outgoing>F04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Ok" name="Onboarding créé ?">
        <bpmn:documentation>Le déclenchement est « best-effort » : un échec n'annule jamais le ticket déjà créé.</bpmn:documentation>
        <bpmn:incoming>F04</bpmn:incoming>
        <bpmn:outgoing>F05</bpmn:outgoing>
        <bpmn:outgoing>F06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Fail" name="Traiter à la main (échec journalisé dans le ticket)">
        <bpmn:documentation>Action « onboarding_rhstudio_failed » écrite dans l'historique du ticket avec le motif. La hot-line traite la demande hors Studio RH.</bpmn:documentation>
        <bpmn:incoming>F06</bpmn:incoming>
        <bpmn:outgoing>F07</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_Manual" name="Traitement manuel">
        <bpmn:incoming>F07</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_Wait" name="Ticket « En attente » + lien du formulaire">
        <bpmn:documentation>Le ticket passe au statut 4 (En attente) ; une notice « Action requise » avec le lien du formulaire manager (token_formulaire) est ajoutée au contenu du ticket. Puis envoi de l'email de confirmation au demandeur.</bpmn:documentation>
        <bpmn:incoming>F05</bpmn:incoming>
        <bpmn:outgoing>F08</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_Mail" name="Envoyer le formulaire d’arrivée au N+1">
        <bpmn:documentation>Studio RH envoie par email au manager (N+1) le lien du formulaire d'arrivée de l'agent (token unique).</bpmn:documentation>
        <bpmn:incoming>F08</bpmn:incoming>
        <bpmn:outgoing>F09</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_Fill" name="Compléter le formulaire d'arrivée">
        <bpmn:documentation>Le N+1 renseigne les besoins de l'agent dans le formulaire public de Studio RH (lien tokenisé). La demande ne sera traitée qu'une fois ce formulaire rempli.</bpmn:documentation>
        <bpmn:incoming>F09</bpmn:incoming>
        <bpmn:outgoing>F10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Gen" name="Générer la checklist d'onboarding">
        <bpmn:documentation>L'onboarding passe à « en_cours_realisation » et Studio RH génère les OnboardingTask du workflow : tâches de type « compte » (création de comptes logiciels) et « autres », chacune soit « email autonome » (gérée dans Studio RH) soit « Tâche DSI Hub » (miroir poussé dans AppDSI).</bpmn:documentation>
        <bpmn:incoming>F10</bpmn:incoming>
        <bpmn:outgoing>F11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Prog" name="Ticket « En cours » : formulaire et checklist en direct">
        <bpmn:documentation>PATCH /api/tasks/external/rh-studio/onboarding-started : le ticket passe de « En attente » (4) à « En cours » (3). PUT …/onboarding-sync : les réponses de l'encadrant sont ajoutées à la description du ticket et la checklist est stockée (hub_tickets.ticket_onboarding) puis affichée en direct dans le ticket (TicketOnboardingPanel, rafraîchie toutes les 20 s).</bpmn:documentation>
        <bpmn:incoming>F11</bpmn:incoming>
        <bpmn:outgoing>F12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="G_Split">
        <bpmn:incoming>F12</bpmn:incoming>
        <bpmn:outgoing>F13</bpmn:outgoing>
        <bpmn:outgoing>F14</bpmn:outgoing>
        <bpmn:outgoing>F15</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="T_Auto" name="Traiter les tâches « email autonome »">
        <bpmn:documentation>Tâches du workflow gérées entièrement côté Studio RH (emails automatiques aux services concernés), sans tâche DSI Hub.</bpmn:documentation>
        <bpmn:incoming>F13</bpmn:incoming>
        <bpmn:outgoing>F20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_DsiTasks" name="Créer les tâches DSI Hub du ticket">
        <bpmn:documentation>POST /api/tasks/external/rh-studio { ticket_id, group_id, description, rh_studio_task_id, echeance } : une tâche (context_source = ticket) par membre du groupe de techniciens choisi dans le workflow, avec notification d'affectation. rh_studio_task_id sert à l'acquittement automatique.</bpmn:documentation>
        <bpmn:incoming>F14</bpmn:incoming>
        <bpmn:outgoing>F16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_Accounts" name="Créer les comptes (AD, messagerie, logiciels)">
        <bpmn:documentation>Les techniciens du groupe réalisent la tâche : compte Active Directory et adresse email, puis comptes dans les logiciels métiers demandés (une tâche par logiciel dans la checklist). Ils passent la tâche à « terminé ».</bpmn:documentation>
        <bpmn:incoming>F16</bpmn:incoming>
        <bpmn:outgoing>F17</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_AD"><bpmn:targetRef>App_AD</bpmn:targetRef></bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="DA_App_Outlook"><bpmn:targetRef>App_Outlook</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_Ack" name="Acquitter la tâche dans Studio RH">
        <bpmn:documentation>Passage de la tâche à « terminé » : AppDSI appelle PATCH {studio}/onboarding/tasks/{id} { done: true } (updateTaskStatus). Sens inverse : PATCH /api/tasks/external/rh-studio/task-completed répercute un acquittement fait dans Studio RH sur la tâche miroir (sans rappel, pas de boucle).</bpmn:documentation>
        <bpmn:incoming>F17</bpmn:incoming>
        <bpmn:outgoing>F18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_AdSync" name="Lier le compte AD à l'agent (matricule)">
        <bpmn:documentation>Module RH : la synchronisation Active Directory/Azure rapproche le nouveau compte de l'agent par matricule (employeeID) puis nom/prénom ; la présence de l'agent s'affiche via AgentPresenceBadge (Studio RH).</bpmn:documentation>
        <bpmn:incoming>F18</bpmn:incoming>
        <bpmn:outgoing>F19</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DA_App_AD2"><bpmn:targetRef>App_AD2</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:manualTask id="T_Mat" name="Préparer et remettre le matériel">
        <bpmn:documentation>Sortie de stock avec bon de livraison signé (module Stocks, rattachée au ticket), affectation dans le Parc informatique (étiquetage, remontée AD) et attribution d'une ligne mobile (Télécom) : PC portable, smartphone, badge.</bpmn:documentation>
        <bpmn:incoming>F15</bpmn:incoming>
        <bpmn:outgoing>F21</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:parallelGateway id="G_Join">
        <bpmn:incoming>F19</bpmn:incoming>
        <bpmn:incoming>F20</bpmn:incoming>
        <bpmn:incoming>F21</bpmn:incoming>
        <bpmn:outgoing>F22</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="T_Check" name="Vérifier la checklist et résoudre le ticket">
        <bpmn:documentation>La hot-line contrôle que toutes les tâches de la checklist sont cochées (indicateur n/total du ticket) puis résout le ticket « Arrivée d'agent ».</bpmn:documentation>
        <bpmn:incoming>F22</bpmn:incoming>
        <bpmn:outgoing>F23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_End" name="Agent opérationnel">
        <bpmn:incoming>F23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="T_Form" />
      <bpmn:sequenceFlow id="F02" sourceRef="T_Form" targetRef="T_Ticket" />
      <bpmn:sequenceFlow id="F03" sourceRef="T_Ticket" targetRef="T_Trig" />
      <bpmn:sequenceFlow id="F04" sourceRef="T_Trig" targetRef="G_Ok" />
      <bpmn:sequenceFlow id="F05" name="oui" sourceRef="G_Ok" targetRef="T_Wait" />
      <bpmn:sequenceFlow id="F06" name="non" sourceRef="G_Ok" targetRef="T_Fail" />
      <bpmn:sequenceFlow id="F07" sourceRef="T_Fail" targetRef="E_Manual" />
      <bpmn:sequenceFlow id="F08" sourceRef="T_Wait" targetRef="T_Mail" />
      <bpmn:sequenceFlow id="F09" sourceRef="T_Mail" targetRef="T_Fill" />
      <bpmn:sequenceFlow id="F10" sourceRef="T_Fill" targetRef="T_Gen" />
      <bpmn:sequenceFlow id="F11" sourceRef="T_Gen" targetRef="T_Prog" />
      <bpmn:sequenceFlow id="F12" sourceRef="T_Prog" targetRef="G_Split" />
      <bpmn:sequenceFlow id="F13" sourceRef="G_Split" targetRef="T_Auto" />
      <bpmn:sequenceFlow id="F14" sourceRef="G_Split" targetRef="T_DsiTasks" />
      <bpmn:sequenceFlow id="F15" sourceRef="G_Split" targetRef="T_Mat" />
      <bpmn:sequenceFlow id="F16" sourceRef="T_DsiTasks" targetRef="T_Accounts" />
      <bpmn:sequenceFlow id="F17" sourceRef="T_Accounts" targetRef="T_Ack" />
      <bpmn:sequenceFlow id="F18" sourceRef="T_Ack" targetRef="T_AdSync" />
      <bpmn:sequenceFlow id="F19" sourceRef="T_AdSync" targetRef="G_Join" />
      <bpmn:sequenceFlow id="F20" sourceRef="T_Auto" targetRef="G_Join" />
      <bpmn:sequenceFlow id="F21" sourceRef="T_Mat" targetRef="G_Join" />
      <bpmn:sequenceFlow id="F22" sourceRef="G_Join" targetRef="T_Check" />
      <bpmn:sequenceFlow id="F23" sourceRef="T_Check" targetRef="E_End" />
      <bpmn:dataStoreReference id="App_DSIHub" name="DSI Hub" dsi:applicationId="158" />
      <bpmn:dataStoreReference id="App_AD" name="AD (Active Directory)" dsi:applicationId="160" />
      <bpmn:dataStoreReference id="App_Outlook" name="Outlook 365 Web Access" dsi:applicationId="76" />
      <bpmn:dataStoreReference id="App_AD2" name="AD (Active Directory)" dsi:applicationId="160" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="3520" height="1075" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Encadrant_di" bpmnElement="Lane_Encadrant" isHorizontal="true"><dc:Bounds x="190" y="80" width="3490" height="215" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AppDSI_di" bpmnElement="Lane_AppDSI" isHorizontal="true"><dc:Bounds x="190" y="295" width="3490" height="215" /></bpmndi:BPMNShape>
