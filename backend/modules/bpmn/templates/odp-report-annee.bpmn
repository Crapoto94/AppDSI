      <bpmndi:BPMNEdge id="F03_di" bpmnElement="F03"><di:waypoint x="760" y="155" /><di:waypoint x="785" y="155" /><di:waypoint x="785" y="480" /><di:waypoint x="810" y="480" /></bpmndi:BPMNEdge>
