      <bpmndi:BPMNShape id="T_Line_di" bpmnElement="T_Line"><dc:Bounds x="1570" y="445" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_LineErr_di" bpmnElement="T_LineErr"><dc:Bounds x="1570" y="555" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Create_di" bpmnElement="T_Create"><dc:Bounds x="1760" y="445" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Err_di" bpmnElement="G_Err" isMarkerVisible="true"><dc:Bounds x="1995" y="455" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Err_di" bpmnElement="T_Err"><dc:Bounds x="2140" y="555" width="140" height="70" /></bpmndi:BPMNShape>
